rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Security Helpers
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.:+@]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Connection Health Verification
    match /test/{docId} {
      allow read, write: if true;
    }

    // Helper: Contact Validation
    function isValidContact(data) {
      return data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 50))
        && (!('email' in data) || (data.email is string && data.email.size() <= 200))
        && (!('company' in data) || (data.company is string && data.company.size() <= 200))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 5000));
    }

    // Contacts Collection
    match /contacts/{contactId} {
      allow get, list: if true;
      allow create: if isValidId(contactId) && isValidContact(incoming());
      allow update: if isValidId(contactId) && isValidContact(incoming());
      allow delete: if isValidId(contactId);
    }

    // Helper: Conversation Validation
    function isValidConversation(data) {
      return data.id is string && data.id.size() <= 128
        && (!('channel' in data) || (data.channel is string && data.channel.size() <= 50))
        && (!('status' in data) || (data.status is string && data.status.size() <= 50))
        && (!('lastMessage' in data) || (data.lastMessage is string && data.lastMessage.size() <= 5000));
    }

    // Conversations Collection
    match /conversations/{conversationId} {
      allow get, list: if true;
      allow create: if isValidId(conversationId) && isValidConversation(incoming());
      allow update: if isValidId(conversationId) && isValidConversation(incoming());
      allow delete: if isValidId(conversationId);

      // Subcollection: Messages
      match /messages/{messageId} {
        allow get, list: if true;
        allow create: if isValidId(messageId) && incoming().content is string && incoming().content.size() <= 10000;
        allow update: if isValidId(messageId) && incoming().content is string && incoming().content.size() <= 10000;
        allow delete: if isValidId(messageId);
      }
    }

    // Messages Collection (Top-level or unified)
    match /messages/{messageId} {
      allow get, list: if true;
      allow create: if isValidId(messageId) && incoming().content is string && incoming().content.size() <= 10000;
      allow update: if isValidId(messageId) && incoming().content is string && incoming().content.size() <= 10000;
      allow delete: if isValidId(messageId);
    }

    // Integrations Collection
    match /integrations/{integrationId} {
      allow get, list: if true;
      allow create, update: if isValidId(integrationId) && incoming().name is string && incoming().name.size() <= 200;
      allow delete: if isValidId(integrationId);
    }

    // Flows Collection
    match /flows/{flowId} {
      allow get, list: if true;
      allow create, update: if isValidId(flowId) && incoming().name is string && incoming().name.size() <= 200;
      allow delete: if isValidId(flowId);
    }

    // Tenants Collection
    match /tenants/{tenantId} {
      allow get, list: if true;
      allow create, update: if isValidId(tenantId) && incoming().name is string && incoming().name.size() <= 200;
      allow delete: if isValidId(tenantId);
    }

    // Audit Logs Collection
    match /auditLogs/{logId} {
      allow get, list: if true;
      allow create: if isValidId(logId) && incoming().action is string && incoming().action.size() <= 200;
      allow update, delete: if false; // Append-only audit logs
    }
  }
}
